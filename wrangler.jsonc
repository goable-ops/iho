{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "iho",
  "main": "worker.js",
  "compatibility_date": "2026-11-14",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    "run_worker_first": ["/api/join", "/api/join/"]
  }
}
